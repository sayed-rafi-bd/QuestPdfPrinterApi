<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows builds target net8.0-windows so the system tray icon (Services\TrayIcon.cs, a
         Windows Forms NotifyIcon) is available. Other OSes build plain net8.0 and TrayIcon
         compiles to a no-op (the WINDOWS symbol is only defined for net8.0-windows). -->
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows</TargetFramework>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>QuestPdfPrinterApi</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Names shown by Windows. Task Manager's "Name" column and the file's Properties -> Details
         come from AssemblyTitle (FileDescription) and Product; the Details tab's process name
         is the exe name (AssemblyName). Keep these in step with AppName/AppExe in installer\LabelApp.iss. -->
    <AssemblyName>ShippingLabelPrinter</AssemblyName>
    <AssemblyTitle>Shipping Label Printer</AssemblyTitle>
    <Product>Shipping Label Printer</Product>
    <Description>Shipping Label Printer</Description>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- The installer build (build-installer.ps1) passes -p:HideConsole=true so the installed
         app runs with no console window. Normal `dotnet run` keeps the console. -->
    <OutputType Condition="'$(HideConsole)' == 'true'">WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms would otherwise add System.Windows.Forms / System.Drawing as implicit
         usings, whose type names (Size, Color, ...) collide with QuestPDF's. TrayIcon.cs imports
         them itself. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon loads this next to the exe (the exe's own embedded icon is the fallback). -->
    <None Update="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Free "Community" tier at this revenue/usage level - see QuestPDF pricing page
         if this ever ships inside a production app for an organization over $1M revenue. -->
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <!-- QuestPDF has no built-in barcode primitive - ZXing.Net encodes the Code128
         barcode and SkiaSharp turns its pixel data into a PNG that QuestPDF's Image()
         element can embed on the label. -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drop the portable SumatraPDF.exe build in Tools/SumatraPDF (see that folder's
         README) and it gets copied next to the app's own binaries on every build, so
         appsettings.json's relative "Printing:SumatraPdfPath" can find it. Matches zero
         files (no build error) until you actually put something there. -->
    <None Include="Tools\SumatraPDF\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same pattern for the CJK font PickingSlipPdfService needs: drop a .ttf/.otf (e.g.
         NotoSansJP-Regular.ttf from Google Fonts) in Tools/Fonts and it's copied next to
         the app's own binaries, so appsettings.json's relative "Fonts:NotoSansJpPath" can
         find it. Matches zero files (no build error) until you actually put something
         there - Program.cs logs a warning and continues without it. -->
    <None Include="Tools\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
